# Copy to demo/env.local.sh (gitignored) and `source` it before running the demo.
# Local-only — NEVER commit real hostnames/ids.

# The governed Orders API endpoint the demo drives (Flex Gateway route base).
# The driver appends /orders/{id} and /profile.
export S7_GW_URL="https://<omni-gw-small-public-host>/orders-demo"

# OPTIONAL — the raw upstream A2D mock (no gateway), for the before/after contrast.
# When set, the driver replays the enumeration client against the ungoverned mock
# to show it is NOT classified/blocked there.
export S7_RAW_URL="https://www.a2d-ai.com/api/platform/<a2d-mock-api-id>"

# --- The demo judge needs NO credentials -------------------------------------
# S7 runs with jevProvider=mock + allowMock=true (deterministic in-policy judge),
# so there is no Jev/LLM key to set here. To demo against a real System-One judge,
# set jevProvider + jevApiKey in demo/config.json instead (see config.json.example).
